{
    "openapi": "3.0.0",
    "info": {
        "title": "Railway Ticket System API",
        "description": "REST API for railway tickets and authentication",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api/v1",
            "description": "API v1"
        }
    ],
    "paths": {
        "/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Автентифікація та отримання Bearer-токена",
                "operationId": "67d6d0fdd54fba132e1b6f55ca254183",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "passenger@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Успішний вхід"
                    },
                    "422": {
                        "description": "Невірні облікові дані"
                    }
                }
            }
        },
        "/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Реєстрація пасажира",
                "operationId": "5d4fa5d5607ed675ba93907e1fc94534",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Іван Петренко"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "passenger@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Користувача створено"
                    },
                    "422": {
                        "description": "Помилка валідації"
                    }
                }
            }
        },
        "/tickets": {
            "get": {
                "tags": [
                    "Tickets"
                ],
                "summary": "Публічний список квитків без персональних даних гостей",
                "operationId": "fff6e8146a3824d22764ad95a401f84f",
                "responses": {
                    "200": {
                        "description": "Список квитків"
                    }
                }
            },
            "post": {
                "tags": [
                    "Tickets"
                ],
                "summary": "Створення квитка",
                "operationId": "5c8efcc66a59d78df909c9a81e1aba91",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "train_route_id",
                                    "passenger_full_name",
                                    "car_number",
                                    "seat_number"
                                ],
                                "properties": {
                                    "train_route_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "passenger_full_name": {
                                        "type": "string",
                                        "example": "Іван Петренко"
                                    },
                                    "car_number": {
                                        "type": "integer",
                                        "example": 3
                                    },
                                    "seat_number": {
                                        "type": "integer",
                                        "example": 12
                                    },
                                    "services": {
                                        "type": "array",
                                        "items": {
                                            "type": "integer"
                                        },
                                        "example": [
                                            1
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Квиток створено"
                    },
                    "401": {
                        "description": "Токен відсутній"
                    },
                    "422": {
                        "description": "Помилка валідації"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/tickets/{ticket}": {
            "get": {
                "tags": [
                    "Tickets"
                ],
                "summary": "Публічний перегляд квитка з прихованими PII для гостей",
                "operationId": "c06419abdf1cfa143b40c9f5f9f8e4ae",
                "parameters": [
                    {
                        "name": "ticket",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Дані квитка"
                    },
                    "403": {
                        "description": "Доступ заборонено"
                    }
                }
            },
            "put": {
                "tags": [
                    "Tickets"
                ],
                "summary": "Оновлення квитка",
                "operationId": "dab26798d7428652e0e7225c7e05adfd",
                "parameters": [
                    {
                        "name": "ticket",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Квиток оновлено"
                    },
                    "403": {
                        "description": "Доступ заборонено"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Tickets"
                ],
                "summary": "Видалення квитка",
                "operationId": "3bab8b8a3f08cafe716de97c72c2f129",
                "parameters": [
                    {
                        "name": "ticket",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Квиток видалено"
                    },
                    "403": {
                        "description": "Доступ заборонено"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "Sanctum",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Tickets",
            "description": "Tickets"
        }
    ]
}